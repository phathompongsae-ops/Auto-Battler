  "phase": "Class 1 directions + core animation set (Idle / Walk / Basic Attack)",
  "date": "2026-10-04",
  "standard": {
    "canvas": "192x192 transparent",
    "feetY": 153,
    "centerX": 95,
    "view": "low top-down",
    "gameHeight": "~40 px (render scale 40/125)",
    "resampling": "none — integer translation / mirror only; no scaling, no smoothing",
    "frameCanvasNote": "Some PixelLab frames arrive on a 204x204 canvas (= 192 + 6 px padding per side, verified pixel-exact); the padding is removed before alignment."
  },
  "pipeline": {
    "rotation": "create_character mode=v3 with reference_image_url = commit-pinned GitHub raw URL of the locked South master (2724fef); 5 generations per class.",
    "southRotation": "PixelLab south rotation overwritten with the exact locked master (save_to_asset), so every South animation starts from the master pixels.",
    "animation": "animate_character mode=v3 custom action_description; idle 4f / walk 8f with keep_first_frame=false; attack 8f + reference frame (reference dropped in the strip). Seeds: PixelLab default (not set).",
    "rejectedMethods": [
      "template mode (breathing-idle / walking-8-frames): redraws the character each frame — taller/slimmer body, different face, ponytail side flip. Rejected for all classes.",
      "skeleton-v3 (breathing-idle): identity stable but re-posed the Archer bow horizontally (weapon jump vs walk). Rejected."
    ],
    "alignment": "Per-direction integer offset measured on the static rotation (feet to y=153, boot/body centre to x=95) and applied to every frame of that direction.",
    "walkGrounding": "Walk strips: per-frame integer vertical re-registration so the lowest planted-foot row sits on y=153 (removes whole-body float; the body bob relative to the feet is kept).",
    "production": "Horizontal strips of 192x192 cells in public/assets/characters/<class>/anims/<class>_<anim>_<dir>.png (same convention as the Warrior). West is not stored: the renderer mirrors East.",
    "gameplayCode": "Integrated (see integration). Combat timing unchanged."
  },
  "recommendedPlayback": {
    "idle": "5 fps loop (Warrior currently 4 fps in code)",
    "walk": "10 fps loop",
    "attackFps": {
      "warrior": 18,
      "archer": 16,
      "mage": 16,
      "cleric": 18,
      "ninja": 20
    },
    "attackNote": "All attacks 8 frames: 444-500 ms, inside a 500 ms basic-attack cooldown; Ninja fastest (400 ms)."
  },
